export interface VDSDecodeResult {
  model?: string;
  variant?: string;
  trim?: string;
  bodyStyle?: string;
  vehicleCategory?: string;
  engine?: string;
  engineCode?: string;
  fuel?: string;
  transmission?: string;
  driveType?: string;
  assemblyPlant?: string;
  doors?: string;
  seats?: string;
  gvm?: string;
  safety?: string;
  confidence?: string;
  evidence?: string[];
}

export type VDSDecoderFunction = (
  vin: string,
  vds: string,
  context?: {
    manufacturer?: string;
    country?: string;
    region?: string;
    year?: string;
  }
) => VDSDecodeResult | undefined;

interface ManufacturerRules {
  decodeVDS?: VDSDecoderFunction;
}

/*
 * RamsCars VIN decoder principle:
 *
 * NEVER manufacture a vehicle identity from a weak pattern.
 *
 * WMI + country + year can be decoded when supported by the database.
 * Model / engine / trim / body / transmission must only be returned
 * when an exact verified manufacturer rule exists.
 *
 * This prevents the extremely dangerous behaviour of turning a
 * plausible pattern into a false vehicle identity.
 */

const registry: Record<string, ManufacturerRules> = Object.create(null);

export function registerManufacturerRules(
  manufacturer: string,
  rules: ManufacturerRules
): void {
  const key = normalizeManufacturer(manufacturer);

  if (!key || !rules) return;

  registry[key] = rules;
}

export function getManufacturerRules(
  manufacturer: string
): ManufacturerRules | undefined {
  return registry[normalizeManufacturer(manufacturer)];
}

export function normalizeManufacturer(manufacturer: string): string {
  return manufacturer
    .trim()
    .toLowerCase()
    .replace(/[^\p{L}\p{N}]+/gu, ' ');
}

/*
 * Built-in priority manufacturer registry.
 *
 * These registrations intentionally do NOT guess model information.
 * They establish the supported manufacturer boundary so exact rules
 * can be added without changing the VIN engine.
 */
const SUPPORTED_MANUFACTURERS = [
  'Toyota',
  'Volkswagen',
  'Ford',
  'Nissan',
  'Hyundai',
  'BMW',
  'BMW M',
  'Mercedes-Benz',
];

for (const manufacturer of SUPPORTED_MANUFACTURERS) {
  registerManufacturerRules(manufacturer, {
    decodeVDS: () => undefined,
  });
}

/*
 * Exact verified rules can be registered here in future.
 *
 * Example:
 *
 * registerManufacturerRules('Toyota', {
 *   decodeVDS: (vin, vds, context) => {
 *     if (EXACT_VERIFIED_PATTERN.test(vds)) {
 *       return {
 *         model: '...',
 *         evidence: ['Exact manufacturer VDS rule ...']
 *       };
 *     }
 *     return undefined;
 *   }
 * });
 *
 * No speculative model mappings are installed.
 */
