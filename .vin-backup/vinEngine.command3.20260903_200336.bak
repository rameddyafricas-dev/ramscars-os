import {
  WMI_DATABASE,
  VIN_DATABASE_VERSION,
  VIN_DECODER_VERSION,
  INVALID_VIN_CHARS,
  YEAR_CODES_FIRST_CYCLE,
  getRegionFromFirstChar,
  isChecksumApplicable,
} from './vinKnowledgeBase';

import {
  getManufacturerRules,
} from './vinManufacturerRules';

import type {
  VinType,
  VinStatus,
  ConfidenceLevel,
  EvidenceItem,
  FieldConfidence,
  ValidationResult,
  DecodedVIN,
} from './vinTypes';

const VIN_ENGINE_VERSION = '3.0.0';

const decodeCache = new Map<string, DecodedVIN>();

const VIN_ALLOWED_PATTERN = /^[A-HJ-NPR-Z0-9]+$/i;

const TRANSLITERATION: Record<string, number> = {
  A: 1,
  B: 2,
  C: 3,
  D: 4,
  E: 5,
  F: 6,
  G: 7,
  H: 8,
  J: 1,
  K: 2,
  L: 3,
  M: 4,
  N: 5,
  P: 7,
  R: 9,
  S: 2,
  T: 3,
  U: 4,
  V: 5,
  W: 6,
  X: 7,
  Y: 8,
  Z: 9,
};

const CHECK_WEIGHTS = [
  8,
  7,
  6,
  5,
  4,
  3,
  2,
  10,
  0,
  9,
  8,
  7,
  6,
  5,
  4,
  3,
  2,
];

function sanitizeVIN(rawVin: string): string {
  return String(rawVin ?? '')
    .trim()
    .toUpperCase()
    .replace(/[\s-]/g, '');
}

function containsInvalidVINCharacters(vin: string): boolean {
  if (!vin) return false;

  if (INVALID_VIN_CHARS.test(vin)) {
    return true;
  }

  return !VIN_ALLOWED_PATTERN.test(vin);
}

function getVinType(clean: string): VinType {
  if (clean.length === 17) return 'modern';

  if (clean.length >= 6 && clean.length < 17) {
    return 'legacy';
  }

  return 'unknown';
}

function validateStructure(clean: string): {
  structural: boolean;
  characterSet: boolean;
  length: boolean;
} {
  const characterSet =
    clean.length === 0 || !containsInvalidVINCharacters(clean);

  const length = clean.length === 17;

  const structural =
    length &&
    characterSet &&
    clean.length === 17;

  return {
    structural,
    characterSet,
    length,
  };
}

function transliterateVINCharacter(character: string): number | null {
  const upper = character.toUpperCase();

  if (upper >= '0' && upper <= '9') {
    return Number(upper);
  }

  return TRANSLITERATION[upper] ?? null;
}

function validateCheckDigit(vin: string): boolean | null {
  if (vin.length !== 17) {
    return null;
  }

  const checkCharacter = vin.charAt(8);

  if (!checkCharacter) {
    return false;
  }

  let sum = 0;

  for (let index = 0; index < 17; index += 1) {
    const value = transliterateVINCharacter(vin.charAt(index));

    if (value === null) {
      return false;
    }

    sum += value * CHECK_WEIGHTS[index];
  }

  const remainder = sum % 11;

  const expected =
    remainder === 10
      ? 'X'
      : String(remainder);

  return checkCharacter === expected;
}

function getModelYearCandidates(yearCode: string): string[] {
  const code = yearCode.toUpperCase();

  const firstYear = YEAR_CODES_FIRST_CYCLE[code];

  if (!firstYear) {
    return [];
  }

  const first = Number(firstYear);

  if (!Number.isFinite(first)) {
    return [];
  }

  return [
    String(first),
    String(first + 30),
    String(first + 60),
  ];
}

function selectModelYear(candidates: string[]): string {
  if (candidates.length === 0) {
    return 'Unknown';
  }

  const currentYear = new Date().getFullYear();

  const validCandidates = candidates
    .map((candidate) => Number(candidate))
    .filter(
      (year) =>
        Number.isInteger(year) &&
        year >= 1980 &&
        year <= currentYear + 1
    );

  if (validCandidates.length === 0) {
    return 'Unknown';
  }

  return String(Math.max(...validCandidates));
}

function buildConfidence(
  value: string,
  level: ConfidenceLevel,
  evidence: EvidenceItem[] = [],
  score = 0
): FieldConfidence {
  return {
    value,
    level,
    score,
    evidence,
  };
}

function unknownField(): FieldConfidence {
  return buildConfidence(
    'Unknown',
    'UNKNOWN',
    [],
    0
  );
}

function normalizeManufacturerName(name: string): string {
  return name
    .trim()
    .toLowerCase()
    .replace(/[^\p{L}\p{N}]+/gu, ' ');
}

function mergeEvidence(
  ...groups: EvidenceItem[][]
): EvidenceItem[] {
  const seen = new Set<string>();
  const result: EvidenceItem[] = [];

  for (const group of groups) {
    for (const item of group) {
      const key = `${item.type}|${item.detail}`;

      if (seen.has(key)) continue;

      seen.add(key);
      result.push(item);
    }
  }

  return result;
}

function calculateOverallConfidence(
  manufacturerRecognized: boolean,
  countryRecognized: boolean,
  modelYearKnown: boolean,
  exactVDSDecoded: boolean,
  checksumApplicable: boolean,
  checksumValid: boolean | null
): {
  level: ConfidenceLevel;
  score: number;
} {
  let score = 0;

  if (manufacturerRecognized) {
    score += 40;
  }

  if (countryRecognized) {
    score += 20;
  }

  if (modelYearKnown) {
    score += 20;
  }

  if (exactVDSDecoded) {
    score += 15;
  }

  /*
   * A valid applicable checksum adds confidence.
   * A checksum failure is deliberately handled separately by the
   * status calculation.
   */
  if (checksumApplicable && checksumValid === true) {
    score += 5;
  }

  score = Math.max(0, Math.min(100, score));

  if (score >= 95) {
    return {
      level: 'VERY_HIGH',
      score,
    };
  }

  if (score >= 80) {
    return {
      level: 'HIGH',
      score,
    };
  }

  if (score >= 60) {
    return {
      level: 'MEDIUM',
      score,
    };
  }

  if (score >= 30) {
    return {
      level: 'LOW',
      score,
    };
  }

  if (score > 0) {
    return {
      level: 'VERY_LOW',
      score,
    };
  }

  return {
    level: 'UNKNOWN',
    score: 0,
  };
}

function determineStatus(params: {
  clean: string;
  vinType: VinType;
  structural: boolean;
  characterSet: boolean;
  wmiRecognized: boolean;
  checksumApplicable: boolean;
  checksumValid: boolean | null;
  exactVDSDecoded: boolean;
}): VinStatus {
  const {
    clean,
    vinType,
    structural,
    characterSet,
    wmiRecognized,
    checksumApplicable,
    checksumValid,
    exactVDSDecoded,
  } = params;

  if (clean.length === 0) {
    return 'EMPTY';
  }

  if (!characterSet) {
    return 'INVALID';
  }

  if (clean.length < 6) {
    return 'INVALID';
  }

  if (vinType === 'legacy') {
    return 'POSSIBLE_LEGACY';
  }

  if (vinType !== 'modern' || !structural) {
    return 'INVALID';
  }

  /*
   * Critical correction:
   *
   * Do NOT reject every 17-character VIN because position 9 does not
   * satisfy the North-American checksum convention.
   *
   * This is especially important for non-North-American VINs.
   */
  if (
    checksumApplicable &&
    checksumValid === false
  ) {
    return 'CHECKSUM_FAILED';
  }

  if (!wmiRecognized) {
    return 'UNKNOWN_WMI';
  }

  if (exactVDSDecoded) {
    return 'FULLY_DECODED';
  }

  return 'PARTIALLY_DECODED';
}

export function decodeVIN(rawVin: string): DecodedVIN {
  const clean = sanitizeVIN(rawVin);

  if (decodeCache.has(clean)) {
    return decodeCache.get(clean)!;
  }

  const vinType = getVinType(clean);

  const structure = validateStructure(clean);

  const wmi = clean.slice(0, 3);
  const vds = clean.slice(3, 8);
  const vis = clean.slice(8);
  const serialNumber =
    clean.length >= 17
      ? clean.slice(11)
      : '';

  const wmiEntry =
    clean.length >= 3
      ? WMI_DATABASE[wmi]
      : undefined;

  const manufacturerRecognized =
    Boolean(wmiEntry?.manufacturer);

  const countryRecognized =
    Boolean(wmiEntry?.country);

  let manufacturer: FieldConfidence =
    unknownField();

  let country: FieldConfidence =
    unknownField();

  if (wmiEntry) {
    const level: ConfidenceLevel =
      wmiEntry.confidence === 'HIGH'
        ? 'HIGH'
        : wmiEntry.confidence === 'MEDIUM'
          ? 'MEDIUM'
          : 'LOW';

    const score =
      level === 'HIGH'
        ? 95
        : level === 'MEDIUM'
          ? 80
          : 60;

    manufacturer = buildConfidence(
      wmiEntry.manufacturer,
      level,
      [
        {
          type: 'WMI',
          detail:
            `WMI ${wmi} identifies ${wmiEntry.manufacturer}`,
        },
      ],
      score
    );

    country = buildConfidence(
      wmiEntry.country,
      level,
      [
        {
          type: 'WMI',
          detail:
            `WMI ${wmi} identifies manufacturing country as ${wmiEntry.country}`,
        },
      ],
      Math.max(0, score - 5)
    );
  }

  const region =
    wmiEntry?.region ||
    getRegionFromFirstChar(clean.charAt(0));

  const checksumApplicable =
    vinType === 'modern' &&
    isChecksumApplicable(wmi);

  const checksumValid =
    checksumApplicable
      ? validateCheckDigit(clean)
      : null;

  let modelYear =
    unknownField();

  let modelYearCandidates: string[] = [];

  if (
    vinType === 'modern' &&
    structure.structural
  ) {
    const yearCode = clean.charAt(9);

    modelYearCandidates =
      getModelYearCandidates(yearCode);

    const selectedYear =
      selectModelYear(modelYearCandidates);

    if (selectedYear !== 'Unknown') {
      const ambiguous =
        modelYearCandidates.filter(
          (candidate) =>
            Number(candidate) <=
            new Date().getFullYear() + 1
        ).length > 1;

      modelYear = buildConfidence(
        selectedYear,
        ambiguous ? 'MEDIUM' : 'HIGH',
        [
          {
            type: 'ISO_3779',
            detail:
              `Position 10 year code ${yearCode} maps to candidate years ${modelYearCandidates.join(', ')}`,
          },
        ],
        ambiguous ? 75 : 95
      );
    }
  }

  let model = unknownField();
  let variant = unknownField();
  let trim = unknownField();
  let vehicleCategory = unknownField();
  let bodyStyle = unknownField();
  let engine = unknownField();
  let engineCode = unknownField();
  let fuel = unknownField();
  let transmission = unknownField();
  let driveType = unknownField();
  let assemblyPlant = unknownField();
  let doors = unknownField();
  let seats = unknownField();
  let gvm = unknownField();
  let safety = unknownField();

  let exactVDSDecoded = false;

  const manufacturerRules =
    manufacturer.value !== 'Unknown'
      ? getManufacturerRules(
          manufacturer.value
        )
      : undefined;

  if (
    manufacturerRules?.decodeVDS &&
    vinType === 'modern' &&
    structure.structural
  ) {
    const decoded =
      manufacturerRules.decodeVDS(
        clean,
        vds,
        {
          manufacturer:
            manufacturer.value,
          country:
            country.value,
          region,
          year:
            modelYear.value,
        }
      );

    if (decoded) {
      const evidence: EvidenceItem[] =
        (decoded.evidence ?? []).map(
          (detail) => ({
            type:
              'ManufacturerDecoder',
            detail,
          })
        );

      if (decoded.model) {
        model = buildConfidence(
          decoded.model,
          'HIGH',
          evidence,
          95
        );
        exactVDSDecoded = true;
      }

      if (decoded.variant) {
        variant = buildConfidence(
          decoded.variant,
          'HIGH',
          evidence,
          95
        );
      }

      if (decoded.trim) {
        trim = buildConfidence(
          decoded.trim,
          'HIGH',
          evidence,
          95
        );
      }

      if (decoded.vehicleCategory) {
        vehicleCategory =
          buildConfidence(
            decoded.vehicleCategory,
            'HIGH',
            evidence,
            95
          );
      }

      if (decoded.bodyStyle) {
        bodyStyle =
          buildConfidence(
            decoded.bodyStyle,
            'HIGH',
            evidence,
            95
          );
      }

      if (decoded.engine) {
        engine =
          buildConfidence(
            decoded.engine,
            'HIGH',
            evidence,
            95
          );
      }

      if (decoded.engineCode) {
        engineCode =
          buildConfidence(
            decoded.engineCode,
            'HIGH',
            evidence,
            95
          );
      }

      if (decoded.fuel) {
        fuel =
          buildConfidence(
            decoded.fuel,
            'HIGH',
            evidence,
            95
          );
      }

      if (decoded.transmission) {
        transmission =
          buildConfidence(
            decoded.transmission,
            'HIGH',
            evidence,
            95
          );
      }

      if (decoded.driveType) {
        driveType =
          buildConfidence(
            decoded.driveType,
            'HIGH',
            evidence,
            95
          );
      }

      if (decoded.assemblyPlant) {
        assemblyPlant =
          buildConfidence(
            decoded.assemblyPlant,
            'MEDIUM',
            evidence,
            80
          );
      }

      if (decoded.doors) {
        doors =
          buildConfidence(
            decoded.doors,
            'HIGH',
            evidence,
            95
          );
      }

      if (decoded.seats) {
        seats =
          buildConfidence(
            decoded.seats,
            'HIGH',
            evidence,
            95
          );
      }

      if (decoded.gvm) {
        gvm =
          buildConfidence(
            decoded.gvm,
            'HIGH',
            evidence,
            95
          );
      }

      if (decoded.safety) {
        safety =
          buildConfidence(
            decoded.safety,
            'HIGH',
            evidence,
            95
          );
      }
    }
  }

  const status =
    determineStatus({
      clean,
      vinType,
      structural:
        structure.structural,
      characterSet:
        structure.characterSet,
      wmiRecognized:
        Boolean(wmiEntry),
      checksumApplicable,
      checksumValid,
      exactVDSDecoded,
    });

  const warnings: string[] = [];

  if (
    checksumApplicable &&
    checksumValid === false
  ) {
    warnings.push(
      'Applicable North-American check digit failed.'
    );
  }

  if (
    vinType === 'modern' &&
    !checksumApplicable
  ) {
    warnings.push(
      'Check digit not treated as mandatory for this market/WMI; VIN validated structurally.'
    );
  }

  if (!wmiEntry && clean.length >= 3) {
    warnings.push(
      `WMI ${wmi} is not present in the RamsCars verified WMI database.`
    );
  }

  if (
    model.value === 'Unknown' &&
    manufacturer.value !== 'Unknown'
  ) {
    warnings.push(
      'Model was not decoded because no exact verified manufacturer VDS rule matched this VIN.'
    );
  }

  if (
    modelYear.value === 'Unknown' &&
    vinType === 'modern'
  ) {
    warnings.push(
      'Model year could not be resolved from the VIN year code.'
    );
  }

  const conflicts: string[] = [];

  if (
    checksumApplicable &&
    checksumValid === false
  ) {
    conflicts.push(
      'VIN checksum conflict.'
    );
  }

  const evidence =
    mergeEvidence(
      manufacturer.evidence,
      country.evidence,
      modelYear.evidence,
      model.evidence,
      variant.evidence,
      trim.evidence,
      bodyStyle.evidence,
      engine.evidence,
      fuel.evidence,
      transmission.evidence,
      assemblyPlant.evidence
    );

  const overall =
    calculateOverallConfidence(
      manufacturerRecognized,
      countryRecognized,
      modelYear.value !== 'Unknown',
      exactVDSDecoded,
      checksumApplicable,
      checksumValid
    );

  const validation: ValidationResult = {
    structural:
      structure.structural,
    characterSet:
      structure.characterSet,
    length:
      structure.length,
    checksumApplicable,
    checksumValid,
    wmiRecognized:
      Boolean(wmiEntry),
    manufacturerRecognized,
    manufacturerRulesAvailable:
      Boolean(manufacturerRules),
    overallStatus:
      status,
  };

  const decoded: DecodedVIN = {
    vin: rawVin,
    normalizedVIN: clean,
    vinType,
    vinStatus: status,
    validation,

    wmi,
    vds,
    vis,
    serialNumber,

    manufacturer,
    country,
    region,

    modelYear,
    modelYearCandidates,

    productionYear:
      modelYear.value !== 'Unknown'
        ? modelYear.value
        : '',

    vehicleCategory,
    bodyStyle,

    model,
    variant,
    trim,

    engine,
    engineCode,
    fuel,
    transmission,
    driveType,

    assemblyPlant,
    doors,
    seats,
    gvm,
    safety,

    confidence: overall,

    evidence,
    conflicts,
    candidates: {},
    warnings,

    decoderVersion:
      `${VIN_ENGINE_VERSION}/${VIN_DECODER_VERSION}`,
    databaseVersion:
      `${VIN_KNOWLEDGE_POLICY_VERSION}/${VIN_DATABASE_VERSION}`,

    decodedAt:
      new Date().toISOString(),
  };

  decodeCache.set(clean, decoded);

  return decoded;
}

export function explainVIN(
  rawVin: string
): string {
  const result =
    decodeVIN(rawVin);

  const lines = [
    `VIN: ${result.vin}`,
    `Normalized: ${result.normalizedVIN}`,
    `Type: ${result.vinType}`,
    `Status: ${result.vinStatus}`,
    `WMI: ${result.wmi}`,
    `VDS: ${result.vds}`,
    `VIS: ${result.vis}`,
    `Serial: ${result.serialNumber}`,
    `Manufacturer: ${result.manufacturer.value} [${result.manufacturer.level}/${result.manufacturer.score}]`,
    `Country: ${result.country.value} [${result.country.level}/${result.country.score}]`,
    `Region: ${result.region}`,
    `Model Year: ${result.modelYear.value}`,
    `Year Candidates: ${result.modelYearCandidates.join(', ') || 'None'}`,
    `Model: ${result.model.value}`,
    `Variant: ${result.variant?.value ?? 'Unknown'}`,
    `Trim: ${result.trim?.value ?? 'Unknown'}`,
    `Engine: ${result.engine?.value ?? 'Unknown'}`,
    `Engine Code: ${result.engineCode?.value ?? 'Unknown'}`,
    `Body: ${result.bodyStyle?.value ?? 'Unknown'}`,
    `Fuel: ${result.fuel?.value ?? 'Unknown'}`,
    `Transmission: ${result.transmission?.value ?? 'Unknown'}`,
    `Drive: ${result.driveType?.value ?? 'Unknown'}`,
    `Assembly Plant: ${result.assemblyPlant?.value ?? 'Unknown'}`,
    `Checksum Applicable: ${result.validation.checksumApplicable}`,
    `Checksum Valid: ${result.validation.checksumValid === null ? 'Not Applicable' : result.validation.checksumValid ? 'YES' : 'NO'}`,
    `Overall Confidence: ${result.confidence.overall} (${result.confidence.score}/100)`,
    `Evidence: ${result.evidence.map((item) => item.detail).join('; ') || 'None'}`,
    `Conflicts: ${result.conflicts.join('; ') || 'None'}`,
    `Warnings: ${result.warnings.join('; ') || 'None'}`,
    `Decoder Version: ${result.decoderVersion}`,
    `Database Version: ${result.databaseVersion}`,
  ];

  return lines.join('\n');
}

export function clearVINCache(): void {
  decodeCache.clear();
}

export function getVINEngineVersion(): string {
  return VIN_ENGINE_VERSION;
}

export function normalizeVIN(rawVin: string): string {
  return sanitizeVIN(rawVin);
}

export function isVINStructurallyValid(
  rawVin: string
): boolean {
  const clean =
    sanitizeVIN(rawVin);

  return validateStructure(clean)
    .structural;
}
